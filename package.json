{
  "name": "repo-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check-types": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@jbpark/ui-kit": "^10.6.0",
    "@jbpark/use-hooks": "^4.7.0",
    "@jbpark/workbench": "^0.3.0",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "codemirror": "^6.0.2",
    "iron-session": "^9.0.1",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-classnames": "^0.10.5",
    "prettier-plugin-merge": "^0.10.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.14.0",
  "description": "Browse your GitHub repositories read-only in the browser, built on @jbpark/workbench",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "**/*.{ts,tsx,mjs}": [
      "bash -c 'pnpm lint'",
      "prettier --write",
      "bash -c 'pnpm check-types'"
    ],
    "**/*.{js,json,css,md}": [
      "prettier --write"
    ]
  }
}
